# Copy this file to ".env" and fill in the values from your Supabase project
# (Supabase dashboard → Project Settings → API).
#
# These are the *public* anon values — safe to ship in a client app. Your
# Anthropic API key is NOT here: it lives only as a Supabase Edge Function
# secret, server-side. See SETUP.md.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
